# For God so loved the world, that He gave His only begotten Son,
# that all who believe in Him should not perish but have everlasting life.
# — John 3:16

# Database connection
# Use SvelteKit database (port 5435) to share Bible data and translations
DATABASE_URL_CHIRHO=postgresql://postgres:asdfasdf@localhost:5435/postgres

# Or use separate Leptos database (port 5436) - requires data migration
# DATABASE_URL_CHIRHO=postgresql://postgres:asdfasdf@localhost:5436/postgres

# Leptos configuration
LEPTOS_OUTPUT_NAME=leptos-platform-chirho
LEPTOS_SITE_ROOT=site
LEPTOS_SITE_PKG_DIR=pkg
LEPTOS_SITE_ADDR=127.0.0.1:3002
LEPTOS_RELOAD_PORT=3003
