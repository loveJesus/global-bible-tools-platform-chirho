# For God so loved the world, that He gave His only begotten Son,
# that all who believe in Him should not perish but have everlasting life.
# — John 3:16

# Database connection
DATABASE_URL_CHIRHO=postgresql://postgres:asdfasdf@localhost:5432/postgres

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET_CHIRHO=your-secret-here

# Public URL
PUBLIC_URL_CHIRHO=http://localhost:5173

# Storage (Cloudflare R2 or MinIO for local dev)
R2_ENDPOINT_CHIRHO=http://localhost:9000
R2_ACCESS_KEY_CHIRHO=minioadmin
R2_SECRET_KEY_CHIRHO=minioadmin
R2_BUCKET_CHIRHO=bible-tools-chirho

# Snapshots Storage (uses same credentials, different bucket)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SNAPSHOT_BUCKET=gbt-snapshots-chirho

# Email (2SMTP)
TWOSMTP_API_KEY_CHIRHO=your-2smtp-api-key
TWOSMTP_FROM_EMAIL_CHIRHO=noreply@global.noreply.fe

# Mailu (optional, for self-hosted email)
MAILU_API_URL_CHIRHO=https://your-mailu-instance.com
MAILU_API_TOKEN_CHIRHO=your-mailu-api-token
